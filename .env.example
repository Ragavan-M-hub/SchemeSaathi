# SchemeSaathi — environment configuration
# Copy to `.env` and adjust. Every value here has a safe development default,
# so an empty .env works for local dev. Production requires JWT_SECRET.

# ------------------------------------------------------------------ runtime
# development | production | test
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# -------------------------------------------------------------------- chatbot
# Get a free key from https://console.groq.com — the chat widget is disabled
# (with a friendly message) until this is set.
GROQ_API_KEY=

# --------------------------------------------------------------------- auth
# REQUIRED in production — the server refuses to boot without it.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_NAME=ss_token
# Set to 1 for split-host deploys (client and API on different domains):
# emits SameSite=None; Secure cookies. Leave 0 for same-origin.
CROSS_SITE_COOKIES=0
# Password hashing cost. 10 is a good default; tests drop to 4 for speed.
BCRYPT_ROUNDS=10

# ----------------------------------------------------------------- database
# File path (relative to repo root) or ":memory:" for an ephemeral DB.
DB_PATH=./data/schemesaathi.db

# --------------------------------------------------------------------- CORS
# Comma-separated allowlist of browser origins. Requests with no Origin header
# (curl, same-origin) always pass. Defaults cover the Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------ client hosting
# When 1, the API also serves the built SPA from dist/ (single-service deploy).
# Defaults to 1 in production, 0 otherwise.
SERVE_CLIENT=

# ----------------------------------------------------------------- demo data
# Seed the demo accounts (asha/ravi/officer/admin @example.com). Off in prod.
SEED_DEMO_USERS=true
DEMO_PASSWORD=demo1234

# ------------------------------------------------------------------ logging
# morgan format (dev | combined | tiny) or "silent".
LOG_LEVEL=dev
